# Normalize line endings to LF on checkout
* text=auto eol=lf

# C/C++ source and headers
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.s text eol=lf
*.S text eol=lf

# STM32CubeIDE / CubeMX project files
*.ioc text eol=lf
*.mxproject text eol=lf
*.launch text eol=lf
*.cproject text eol=lf
*.project text eol=lf

# Scripts
*.sh text eol=lf
Makefile text eol=lf

# Binary files — never touch line endings or diff as text
*.bin binary
*.elf binary
*.hex binary
*.a binary
*.o binary
*.d binary
